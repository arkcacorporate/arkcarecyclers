# ==============================================================================
# ARKCA Recyclers - Server-Side Environment Configuration Template
# ==============================================================================
# NOTE: Set real values in your hosting dashboard (e.g. Netlify / Vercel)
# or in local .env.local file. Never commit real credentials to GitHub.
# ==============================================================================

# MongoDB Atlas Connection URI
# Example: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=arkca_recyclers

# Notification Recipient Addresses (Configured in hosting environment variables)
EMAIL_TO_1=your-email1@example.com
EMAIL_TO_2=your-email@example.com
EMAIL_TO_3=your-email3@example.com

# Server-Side Business Email / SMTP Configuration
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ARKCA Recyclers" <noreply@example.com>
