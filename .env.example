# ==============================================================================
# ARKCA Corporate - Server-Side Environment Configuration Template
# ==============================================================================
# Configure these variables in Hostinger / production hosting settings or .env.local
# Never commit real credentials to GitHub.
# ==============================================================================

# Server-Side Business Email / SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=corporate@example.com
SMTP_PASSWORD=your-secure-smtp-password
SMTP_FROM="ARKCA Corporate" <corporate@example.com>

# Destination Business Email for Website Enquiries (Single address or comma-separated)
ENQUIRY_RECEIVER_EMAIL=contact@example.com
