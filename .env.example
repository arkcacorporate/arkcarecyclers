# Server-Side Business Email / SMTP Configuration (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=corporate@arkcarecyclers.com
SMTP_PASSWORD=your-password
SMTP_FROM="ARKCA Corporate" <corporate@arkcarecyclers.com>

# Destination Business Email for Website Enquiries (comma-separated list of recipients)
ENQUIRY_RECEIVER_EMAIL=corporate@arkcarecyclers.com,certificate@arkcacorporate.com,ankitaarkca@gmail.com

