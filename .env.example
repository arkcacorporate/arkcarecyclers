# ==============================================================================
# ARKCA Recyclers - Server-Side Environment Configuration
# ==============================================================================
# NOTE: Variables here are accessible only in Node.js server environments.
# They are never bundled into client-side JavaScript.
# Never commit real credentials, passwords, or URIs to GitHub.
# ==============================================================================

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@arkca-cluster.xxxxx.mongodb.net/arkca_recyclers?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=arkca_recyclers

# Notification Recipient Addresses (Enquiries will be dispatched to all 3)
EMAIL_TO_1=contact@arkcarecyclers.com
EMAIL_TO_2=certificate@arkcacorporate.com
EMAIL_TO_3=ankitaarkca@gmail.com

# Server-Side Business Email / SMTP Configuration
# (e.g. Google Workspace, Microsoft 365, Zoho Mail, cPanel / Webmail, or custom mail server)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ARKCA Recyclers" <noreply@arkcarecyclers.com>
